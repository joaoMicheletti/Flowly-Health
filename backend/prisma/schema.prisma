
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String  @id @default(uuid())
  name      String
  email     String?
  phone     String?
  isActive  Boolean @default(true)

  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?

  users          User[]
  patients       Patient[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

model User {
  id       String @id @default(uuid())
  clinicId String

  name     String
  email    String @unique
  password String
  role     UserRole @default(RECEPTIONIST)

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@unique([clinicId, id])
  @@index([clinicId])
  @@index([clinicId, role])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

model Patient {
  id       String @id @default(uuid())
  clinicId String

  name  String
  email String
  phone String?

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@unique([clinicId, id])
  @@index([clinicId])
  @@index([clinicId, name])

  createdAt DateTime @default(now())
}

model Appointment {
  id        String @id @default(uuid())
  clinicId  String
  patientId String
  userId    String

  date   DateTime
  status AppointmentStatus @default(SCHEDULED)
  type   AppointmentType   @default(CONSULTATION)

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  user    User    @relation(fields: [clinicId, userId], references: [clinicId, id], onDelete: Restrict)

  @@index([clinicId, date])
  @@index([clinicId, patientId])
  @@index([clinicId, userId, date])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentType {
  CONSULTATION
  RETURN
  EVALUATION
}

model MedicalRecord {
  id        String @id @default(uuid())
  clinicId  String
  patientId String
  userId    String

  chiefComplaint     String?
  diagnosis          String?
  procedurePerformed String?
  prescription       String?
  notes              String?
  returnDate         DateTime?

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  user    User    @relation(fields: [clinicId, userId], references: [clinicId, id], onDelete: Restrict)

  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, userId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
